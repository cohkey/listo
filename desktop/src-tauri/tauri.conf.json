{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Listo",
  "version": "0.1.0",
  "identifier": "com.cohkey.tempo",
  "build": {
    "frontendDist": "../../docs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Listo",
        "width": 1366,
        "height": 860,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
